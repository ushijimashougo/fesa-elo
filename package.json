{
  "name": "@nanamemichi/fesa-elo",
  "version": "0.1.0",
  "description": "TypeScript implementation of the FESA Pan-Atlantic Elo rating system for shogi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
